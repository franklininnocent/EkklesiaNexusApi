APP_NAME=EkklesiaNexus
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12


# Super Admin seed account (required for SuperAdminUserSeeder / initial platform setup)
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=


LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Production server only (DigitalOcean blocks SMTP 25/465/587). Do not set these locally.
# MAIL_MAILER=resend
# RESEND_KEY=
# MAIL_FROM_ADDRESS=contact@ekklesianexus.com
# MAIL_FROM_NAME=EkklesiaNexus

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Financial AI (optional LLM enhancement)
FINANCIAL_AI_LLM_ENABLED=false
FINANCIAL_AI_LLM_API_KEY=
OPENAI_API_KEY=

# WhatsApp Business API (optional; falls back to wa.me manual links)
WHATSAPP_BUSINESS_ENABLED=false
WHATSAPP_BUSINESS_API_VERSION=v21.0
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCESS_TOKEN=
WHATSAPP_BUSINESS_TIMEOUT=15

# Tenant Data Export
TENANT_EXPORT_RETENTION_DAYS=7
TENANT_EXPORT_MAX_ACTIVE_PER_TENANT=1
TENANT_EXPORT_MAX_CONCURRENT_GLOBAL=2
TENANT_EXPORT_CHUNK_SIZE=500
TENANT_EXPORT_JOB_TIMEOUT=1800
TENANT_EXPORT_QUEUE=tenant-exports
TENANT_EXPORT_DISK=local

# Application Access & Security Monitoring
TRUSTED_PROXIES=
APPLICATION_ACCESS_TELEMETRY_ENABLED=true
APPLICATION_ACCESS_IDLE_MINUTES=15
APPLICATION_ACCESS_SSE_MAX_CONNECTIONS=10
APPLICATION_ACCESS_SSE_TTL=120
APPLICATION_ACCESS_SSE_HEARTBEAT=20
APPLICATION_ACCESS_RETENTION_EVENTS=90
APPLICATION_ACCESS_RETENTION_SECURITY=180
APPLICATION_ACCESS_RETENTION_SIGNALS=90
APPLICATION_ACCESS_RETENTION_SESSIONS=90
APPLICATION_ACCESS_RETENTION_SCHEDULER_ENABLED=true
APPLICATION_ACCESS_RETENTION_DAY=sunday
APPLICATION_ACCESS_RETENTION_TIME=03:30
GEOIP_DATABASE=

# Subscription plans & entitlements (Modules/Subscriptions)
# legacy | shadow | enforce. Switch to enforce only after
# `php artisan subscriptions:verify-entitlement-parity` reports no mismatches.
SUBSCRIPTIONS_ENTITLEMENT_ENGINE=shadow
SUBSCRIPTIONS_ENTITLEMENT_CACHE_TTL=900
SUBSCRIPTIONS_PUBLIC_PLANS_CACHE=300
SUBSCRIPTIONS_LIFECYCLE_SCHEDULER_ENABLED=true
SUBSCRIPTIONS_USAGE_SNAPSHOT_ENABLED=true
SUBSCRIPTIONS_USAGE_SNAPSHOT_TIME=02:10
SUBSCRIPTIONS_USAGE_ALERTS_ENABLED=true
SUBSCRIPTIONS_USAGE_ALERTS_TIME=02:40

# Redis application cache
REDIS_DB=0
REDIS_CACHE_DB=1

# --- EkklesiaNexus production (set on the server; keep local defaults above) ---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://api.ekklesianexus.com
# FRONTEND_URL=https://app.ekklesianexus.com
# MARKETING_URL=https://ekklesianexus.com
# EMAIL_PRODUCT_NAME=EkklesiaNexus
# MAIL_FROM_NAME=EkklesiaNexus
# MAIL_FROM_ADDRESS=contact@ekklesianexus.com
# TRUSTED_PROXIES=127.0.0.1
# SESSION_SECURE_COOKIE=true

