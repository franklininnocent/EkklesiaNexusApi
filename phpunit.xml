<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
            <directory>Modules/*/tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <directory>Modules/*/tests/Feature</directory>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <group>legacy-mass-obligation</group>
            <group>pgsql</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="REDIS_CLIENT" value="predis"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="SUPER_ADMIN_EMAIL" value="super-admin-notify@example.test"/>
        <env name="SUPER_ADMIN_NAME" value="EkklesiaNexus Super Admin"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="TENANT_ORM_GLOBAL_SCOPE" value="false"/>
        <env name="TENANT_RLS_ENABLED" value="false"/>
        <env name="TENANT_API_RATE_LIMIT_ENABLED" value="false"/>
        <env name="APPLICATION_ACCESS_TELEMETRY_ENABLED" value="false" force="true"/>
        <env name="MARKETING_CAPTCHA_TEST_SEEDING" value="true" force="true"/>
    </php>
</phpunit>
